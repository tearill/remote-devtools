{
  "name": "remote-devtools",
  "version": "1.0.1",
  "scriptName": "remote-devtools",
  "description": "A generic remote debugging tools.",
  "main": "electron/main.js",
  "bin": {
    "remote-devtools": "bin/remote-devtools.js",
    "rdt": "bin/remote-devtools.js"
  },
  "engines": {
    "node": ">=12.0.0"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "start": "node bin/remote-devtools.js",
    "electron": "npm run build && electron .",
    "electron:dev": "electronmon .",
    "dist": "npm run build && node scripts/dist.js",
    "dist:mac": "npm run build && node scripts/dist.js --mac",
    "dist:win": "npm run build && node scripts/dist.js --win",
    "dist:linux": "npm run build && node scripts/dist.js --linux",
    "prepublish": "npm run build"
  },
  "keywords": [
    "remote-devtools",
    "devtool",
    "chrome",
    "debug",
    "websocket"
  ],
  "dependencies": {
    "chalk": "^4.1.0",
    "chii": "~0.6.6",
    "chobitsu": "~0.2.1",
    "circular-json": "~0.5.9",
    "ejs": "~3.1.5",
    "find-cache-dir": "^3.3.2",
    "killable": "^1.0.1",
    "mime": "1.6.0",
    "nanoid": "~3.1.12",
    "node-forge": "^1.4.0",
    "on-finished": "^2.4.1",
    "opener": "^1.5.2",
    "portfinder": "~1.0.28",
    "qrcode": "^1.5.4",
    "selfsigned": "^2.0.1",
    "semver": "~7.3.2",
    "update-notifier": "~4.1.1",
    "webpack-log": "^3.0.2",
    "whistle": "^2.10.2",
    "ws": "~7.3.1",
    "yargs": "~15.4.1"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/plugin-transform-runtime": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "babel-loader": "^9.1.3",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "electronmon": "^2.0.4",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "author": "tearill",
  "license": "MIT",
  "build": {
    "appId": "com.remote-devtools.app",
    "productName": "Remote DevTools",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "public/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
